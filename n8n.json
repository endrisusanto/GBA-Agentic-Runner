      "parameters": {
        "url": "http://192.168.10.221:3030/api/devices",
        "options": {}
      },
      "id": "get-devices",
      "name": "Get Devices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        800
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst devices = items.length > 0 ? items.map(i => i.json) : [];\nconst ready = devices.filter(d => d.state === 'device' && !d.busy).sort((a, b) =>\n  String(a.model || '').localeCompare(String(b.model || '')) ||\n  String(a.serial || '').localeCompare(String(b.serial || ''))\n);\n\nlet chat_id = 0, msg_text = '', cb_data = '', cb_id = '';\ntry {\n  const p = $('Telegram Trigger').first().json;\n  if (p.message) {\n    chat_id = p.message.chat.id;\n    msg_text = p.message.text || '';\n  } else if (p.callback_query) {\n    chat_id = p.callback_query.message.chat.id;\n    cb_data  = p.callback_query.data || '';\n    cb_id    = p.callback_query.id || '';\n  }\n} catch(e) {}\n\nconst cmd = msg_text.trim().toLowerCase();\nconst mainMenu = { inline_keyboard: [\n  [{ text: '\\ud83d\\udcfa Perangkat & Run', callback_data: 'menu_list' }],\n  [{ text: '\\ud83d\\udcca Status', callback_data: 'menu_status' }, { text: '\\ud83d\\udccb Log', callback_data: 'menu_log' }],\n  [{ text: '\\u26d4 Cancel', callback_data: 'menu_cancel' }, { text: '\\ud83d\\udd04 Reset', callback_data: 'menu_reset' }],\n  [{ text: 'PC Resource', callback_data: 'diag_resource' }, { text: 'Internet Speed', callback_data: 'diag_speed' }],\n  [{ text: 'Tools Version', callback_data: 'diag_tools' }]\n]};\n\nconst mk = (action, text, markup, extra) => [{ json: Object.assign(\n  { action, chat_id, cb_id, pending_text: text, reply_markup: markup || null, main_menu: mainMenu,\n    serial: '', test_type: '', user_devices: [], userdebug_devices: [] },\n  extra || {}\n)}];\n\nif (cb_data.startsWith('shot_')) {\n  const serial = cb_data.slice(5);\n  const dev = devices.find(d => d.serial === serial);\n  return mk('screenshot', '\\ud83d\\udcf8 Screenshot ' + (dev && dev.model || serial) + '...', null, { serial });\n}\nif (cb_data === 'menu_status' || cmd === '/status') return mk('status', '\\u23f3 Mengambil status...', null, {});\nif (cb_data === 'menu_log'    || cmd === '/log')    return mk('log',    '\\u23f3 Mengambil log...', null, {});\nif (cb_data.startsWith('log_run_')) {\n  const run_id = cb_data.slice('log_run_'.length);\n  return mk('log_fetch', '\\ud83d\\udccb Mengambil log flow...', null, {\n    run_id,\n  });\n}\nif (cb_data.startsWith('zip_')) {\n  const parts = cb_data.slice(4).split('|');\n  return mk('zip_fetch', 'Mengirim zip result...', null, { run_id: parts[0], zip_id: Number(parts[1]) });\n}\nif (cb_data === 'menu_cancel' || cmd === '/cancel') return mk('cancel', '\\u26d4 Membatalkan tes...', null, {});\nif (cb_data === 'menu_reset'  || cmd === '/reset')  return mk('reset',  '\\ud83d\\udd04 Mereset status...', null, {});\nif (cb_data.startsWith('diag_')) return mk('diagnostics', 'Mengambil diagnostics...', null, { diagnostic_type: cb_data.slice(5) });\n\nif (cb_data.startsWith('test_')) {\n  const m = cb_data.match(/^test_([^_]+)_(.+)$/);\n  if (!m) return mk('menu', '\\u274c Command tidak valid.', mainMenu, {});\n  const test_type = m[1], nums = m[2].split(',').map(Number);\n  const all_conn = devices.filter(d => d.state === 'device');\n  const getD = n => ready[n-1] || all_conn[n-1] || devices[n-1] || {};\n  const user_devices      = nums.map(getD).filter(d => d.serial && !d.is_userdebug).map(d => d.serial);\n  const userdebug_devices = nums.map(getD).filter(d => d.serial &&  d.is_userdebug).map(d => d.serial);\n  return mk('run',\n    '\\ud83d\\ude80 Memulai ' + test_type + ': ' + [...user_devices, ...userdebug_devices].join(', ') + '...',\n    null, { test_type, user_devices, userdebug_devices }\n  );\n}\n\nif (cb_data === 'menu_list' || cmd.startsWith('/run')) {\n  if (!ready.length) return mk('menu', '\\u274c Tidak ada perangkat siap.', mainMenu, {});\n  const runM = msg_text.match(/^\\/run\\s+(.+)$/i);\n  if (runM) {\n    const nums = runM[1].split(',').map(s => parseInt(s.trim())).filter(n => n > 0 && n <= ready.length);\n    if (!nums.length) return mk('menu', '\\u274c Nomor tidak valid.', mainMenu, {});\n    return mk('menu', 'Pilih tes untuk ' + nums.join(', ') + ':', { inline_keyboard: [\n      [{ text: '\\u25b6\\ufe0f MR',  callback_data: 'test_MR_'  + nums.join(',') },\n       { text: '\\u25b6\\ufe0f SMR', callback_data: 'test_SMR_' + nums.join(',') }],\n      [{ text: '\\u25b6\\ufe0f SKU', callback_data: 'test_SKU_' + nums.join(',') },\n       { text: '\\u25b6\\ufe0f STS', callback_data: 'test_STS_' + nums.join(',') }],\n      [{ text: '\\ud83d\\udd19 Kembali', callback_data: 'menu_main' }]\n    ]}, {});\n  }\n  const values = ready.map(d => ({ model: String(d.model || '-'), type: d.is_userdebug ? 'USERDEBUG' : 'USER', pda: String(d.pda || '-'), code: String(d.sales_code || '-') }));\n  const widths = {\n    no: Math.max(2, String(ready.length).length),\n    model: Math.max(5, ...values.map(d => d.model.length)),\n    type: Math.max(4, ...values.map(d => d.type.length)),\n    pda: Math.max(3, ...values.map(d => d.pda.length)),\n    code: Math.max(4, ...values.map(d => d.code.length))\n  };\n  const cell = (value, width) => { const text = String(value || '-').slice(0, width); const pad = width - text.length; return ' '.repeat(Math.floor(pad / 2)) + text + ' '.repeat(Math.ceil(pad / 2)); };\n  const rows = [cell('No', widths.no) + ' │ ' + cell('Model', widths.model) + ' │ ' + cell('Type', widths.type) + ' │ ' + cell('PDA', widths.pda) + ' │ ' + cell('Code', widths.code)];\n  const kb = [];\n  let deviceRow = [];\n  ready.forEach((d, i) => {\n    const value = values[i];\n    rows.push(cell(i + 1, widths.no) + ' │ ' + cell(value.model, widths.model) + ' │ ' + cell(value.type, widths.type) + ' │ ' + cell(value.pda, widths.pda) + ' │ ' + cell(value.code, widths.code));\n    deviceRow.push({ text: '\\ud83d\\udcf8 ' + (d.model||d.serial), callback_data: 'shot_' + d.serial });\n    if (deviceRow.length === 3) { kb.push(deviceRow); deviceRow = []; }\n  });\n  if (deviceRow.length) kb.push(deviceRow);\n  const msg = '\\ud83d\\udcfa *Daftar Perangkat Siap Tes:*\\n\\n```\\n' + rows.join('\\n') + '\\n```\\n\\ud83d\\udc49 Ketik `/run 1,2` untuk memilih';\n  kb.push([{ text: '\\ud83d\\udd19 Kembali', callback_data: 'menu_main' }]);\n  return mk('menu', msg, { inline_keyboard: kb }, {});\n}\n\nreturn mk('menu', '\\ud83e\\udd16 *GBA Agentic Bot*\\n\\nPilih aksi:', mainMenu, {});\n"
      },
